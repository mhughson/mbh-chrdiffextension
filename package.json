{
  "name": "nes-chr-diff-viewer",
  "displayName": "NES CHR Diff Viewer",
  "description": "Visual diffing for NES .chr binary image files in Git view, with before/after and pixel-difference previews using NES palette.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:chr",
    "onLanguage:chr",
    "onCommand:nes-chr-diff-viewer.helloWorld"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nes-chr-diff-viewer.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "nes-chr-diff-viewer.comparisonDiagnostics",
        "title": "NES CHR: Show Comparison Diagnostics"
      }
    ],
    "customEditors": [
      {
        "viewType": "nes-chr-diff-viewer.chrDiff",
        "displayName": "NES CHR Diff Viewer",
        "selector": [
          {
            "filenamePattern": "*.chr"
          }
        ]
      }
    ],
    "configuration": {
      "title": "NES CHR Diff Viewer",
      "properties": {
        "nes-chr-diff-viewer.palette": {
          "type": "array",
          "markdownDescription": "Colors used to draw CHR pixel values 0–3, as hex colors (`#rgb`, `#rrggbb` or `#rrggbbaa`).",
          "items": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color such as #AAFFAA."
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            "#000000",
            "#555555",
            "#AAAAAA",
            "#FFFFFF"
          ]
        },
        "nes-chr-diff-viewer.changedPalette": {
          "type": "array",
          "markdownDescription": "Colors used for pixel values 0–3 of changed pixels when **Show changes** is on in a diff. Also colors the active toggle.",
          "items": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color such as #AAFFAA."
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            "#004400",
            "#008800",
            "#55CC55",
            "#AAFFAA"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "esbuild": "^0.25.9",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mhughson/mbh-chrdiffextension.git"
  },
  "keywords": [
    "nes"
  ],
  "author": "Matt Hughson",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mhughson/mbh-chrdiffextension/issues"
  },
  "homepage": "https://github.com/mhughson/mbh-chrdiffextension#readme"
}
